# Application Configuration
APP_NAME="Thibitisha Skills"

# Database Configuration (MySQL)
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/thibitisha_skills?charset=utf8mb4"

# JWT Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# File Upload Settings
UPLOAD_DIR=""
MAX_CV_SIZE_MB=5

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Assessment Configuration
QUESTIONS_PER_ASSESSMENT=10
PASS_PERCENTAGE=50.0
MAX_ASSESSMENTS_PER_DAY=5

# Initial Admin User (optional seed)
ADMIN_EMAIL="admin@thibitishaskills.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Platform Administrator"

