# Copy to backend/.env and fill with REAL values. Never commit backend/.env.
# Placeholders below are INVALID for running the API (config will refuse them).

# Application Configuration
APP_NAME="Thibitisha Skills"

# Database Configuration (MySQL) — REQUIRED
DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4"

# JWT Authentication — REQUIRED (min 32 random chars; not a replace-this placeholder)
JWT_SECRET_KEY="GENERATE_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API — required for CV analysis and assessments
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# File Upload Settings
UPLOAD_DIR=""
MAX_CV_SIZE_MB=5

# CORS Settings (comma-separated origins; never use *)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Assessment Configuration
QUESTIONS_PER_ASSESSMENT=10
PASS_PERCENTAGE=50.0
MAX_ASSESSMENTS_PER_DAY=5

# Initial Admin User (optional seed on startup)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Platform Administrator"
